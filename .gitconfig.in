[user]
  name = name
  email = idk@gmail.com
[core]
  editor = nvim
  autocrlf = false
[alias]
  st = status
  ss = status --short --branch

  ad = add
  au = add -u

  cm = commit -m
  ci = --commit --reuse-message=HEAD

  mg = merge

  re = restore
  rs = restore --staged

  f4 = fetch

  pl = pull

# branches
  br = branch
  brr = branch -r

  ck = checkout
  sw = switch
  sc = switch -c

# Misc
  tg = tag -a

  rback = reset HEAD^

  nuke = `!git reset --hard HEAD && git clean -fd`

# Log
  lo = log --oneline
  ll = log --pretty=format:"%C(yellow)%h%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --numstat
  ld = log --pretty=format:"%C(yellow)%h\\ %C(green)%ad%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=short --graph
  ls = log -n 10 --pretty=format:"%C(green)%h\\ %C(yellow)[%ad]%Cred%d\\ %Creset%s%Cblue\\ [%cn]" --decorate --date=relative 

[credential "https://github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
[credential "https://gist.github.com"]
	helper = 
	helper = !/usr/bin/gh auth git-credential
